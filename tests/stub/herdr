#!/usr/bin/env bash
# Fake herdr. Logs every call; answers from canned JSON files.
set -uo pipefail
log="${HERDR_STUB_LOG:?}"
printf '%s\n' "$*" >> "$log"
cmd="${1:-}"; sub="${2:-}"
# HERDR_STUB_VERSION lets a test pretend to be any herdr; unset means the version dkbo verified.
if [ "$cmd" = --version ]; then echo "herdr ${HERDR_STUB_VERSION-0.9.0}"; exit 0; fi
key="${cmd}_${sub}"
if [ "${HERDR_STUB_FAIL:-}" = "$cmd $sub" ]; then
  echo '{"error":{"code":"stubbed_failure"}}' >&2; exit 1
fi
# HERDR_STUB_MISSING: space-separated agent targets herdr does not know. Real herdr answers
# agent_not_found with a non-zero rc, which is what made every dk-msg in the sportswitch task
# undeliverable; without this the stub answers every target and no test can see it.
for m in ${HERDR_STUB_MISSING:-}; do
  if [ "$cmd" = agent ] && [ "$m" = "${3:-}" ]; then
    echo "{\"error\":{\"code\":\"agent_not_found\",\"message\":\"agent target $3 not found\"}}" >&2; exit 1
  fi
done
# 真 herdr 的 rename 會改變之後 agent get 讀到的名字。stub 不模擬這一步的話，「rename 回 rc=0
# 卻沒生效」與正常長得一模一樣，dk-task-new 的守衛就無從測起 —— sportswitch 整場訊息全滅正是
# 卡在這個分不出來的縫。HERDR_STUB_RENAME_NOOP=1 演的就是那種靜默失敗。
if [ "$cmd" = agent ] && [ "$sub" = rename ] && [ -z "${HERDR_STUB_RENAME_NOOP:-}" ]; then
  n="${4:-}"
  if [ "$n" = --clear ]; then n=null; else n="\"$n\""; fi
  printf '{"id":"cli:agent:get","result":{"agent":{"agent":"claude","name":%s,"agent_status":"idle","pane_id":"%s"}}}\n' \
    "$n" "${3:-}" > "${HERDR_STUB_RESPONSES:?}/agent_get.json"
fi
f="${HERDR_STUB_RESPONSES:?}/${key}.json"
if [ -f "$f" ]; then cat "$f"; else echo "{\"id\":\"cli:$cmd:$sub\",\"result\":{}}"; fi
