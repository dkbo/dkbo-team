#!/usr/bin/env bash
# Fake herdr. Logs every call; answers from canned JSON files.
set -uo pipefail
log="${HERDR_STUB_LOG:?}"
printf '%s\n' "$*" >> "$log"
cmd="${1:-}"; sub="${2:-}"
# HERDR_STUB_VERSION lets a test pretend to be any herdr; unset means the version dkbo verified.
if [ "$cmd" = --version ]; then echo "herdr ${HERDR_STUB_VERSION-0.9.0}"; exit 0; fi
# AC18：真 herdr 拒收非 UTF-8 參數（rc=2）——`agent prompt` 的內文若切出半個字元就送不到，
# stub 比照這個行為，測試才抓得到 dk-watch 的截斷是不是按位元組切的。
dk_stub_utf8_valid() {
  # 用 od 逐位元組讀（純數字，不靠 grep/read 對文字的 locale 假設——那條路子在某些
  # locale 下會把整行吞掉或把多位元組字元黏成一個 token，比要驗的問題更難察覺）。
  local s="$1" byte need=0
  while read -r byte; do
    [ -n "$byte" ] || continue
    if [ "$need" -gt 0 ]; then
      [ $((byte & 0xC0)) -eq 128 ] || return 1
      need=$((need - 1)); continue
    fi
    if [ $((byte & 0x80)) -eq 0 ]; then continue
    elif [ $((byte & 0xE0)) -eq 192 ]; then need=1
    elif [ $((byte & 0xF0)) -eq 224 ]; then need=2
    elif [ $((byte & 0xF8)) -eq 240 ]; then need=3
    else return 1
    fi
  done < <(printf '%s' "$s" | od -An -v -tu1 | tr -s ' ' '\n' | sed '/^$/d')
  [ "$need" -eq 0 ]
}
if [ "$cmd" = agent ] && [ "$sub" = prompt ] && [ -n "${4:-}" ] && ! dk_stub_utf8_valid "${4:-}"; then
  echo '{"error":{"code":"invalid_argument","message":"argument 4 is not valid UTF-8"}}' >&2; exit 2
fi
key="${cmd}_${sub}"
if [ "${HERDR_STUB_FAIL:-}" = "$cmd $sub" ]; then
  echo '{"error":{"code":"stubbed_failure"}}' >&2; exit 1
fi
# HERDR_STUB_MISSING: space-separated agent targets herdr does not know. Real herdr answers
# agent_not_found with a non-zero rc, which is what made every dk-msg in the sportswitch task
# undeliverable; without this the stub answers every target and no test can see it.
for m in ${HERDR_STUB_MISSING:-}; do
  if [ "$cmd" = agent ] && [ "$m" = "${3:-}" ]; then
    echo "{\"error\":{\"code\":\"agent_not_found\",\"message\":\"agent target $3 not found\"}}" >&2; exit 1
  fi
done
# 真 herdr 的 rename 會改變之後 agent get 讀到的名字。stub 不模擬這一步的話，「rename 回 rc=0
# 卻沒生效」與正常長得一模一樣，dk-task-new 的守衛就無從測起 —— sportswitch 整場訊息全滅正是
# 卡在這個分不出來的縫。HERDR_STUB_RENAME_NOOP=1 演的就是那種靜默失敗。
if [ "$cmd" = agent ] && [ "$sub" = rename ] && [ -z "${HERDR_STUB_RENAME_NOOP:-}" ]; then
  n="${4:-}"
  if [ "$n" = --clear ]; then n=null; else n="\"$n\""; fi
  printf '{"id":"cli:agent:get","result":{"agent":{"agent":"claude","name":%s,"agent_status":"idle","pane_id":"%s"}}}\n' \
    "$n" "${3:-}" > "${HERDR_STUB_RESPONSES:?}/agent_get.json"
fi
# agent start 之後，真 herdr 的 `agent get <那個 pane>` 會回剛起的 agent。stub 不記這一步的話，
# dk-leader --run 的「已交棒就只印一行」幂等判斷無從測起 —— 它問的正是根 pane 上有沒有 leader-<short>。
# 逐 pane 一個檔，所以只有真的被 start 過的 pane 會改答案，其他 pane 照舊讀通用的 agent_get.json。
if [ "$cmd" = agent ] && [ "$sub" = start ]; then
  _n="${3:-}"; _p=""; _prev=""
  for _a in "$@"; do
    if [ "$_prev" = --pane ]; then _p="$_a"; break; fi
    _prev="$_a"
  done
  if [ -n "$_p" ]; then
    printf '{"id":"cli:agent:get","result":{"agent":{"agent":"claude","name":"%s","agent_status":"idle","pane_id":"%s"}}}\n' \
      "$_n" "$_p" > "${HERDR_STUB_RESPONSES:?}/agent_get.$_p.json"
  fi
fi
if [ "$cmd" = agent ] && [ "$sub" = get ] && [ -f "${HERDR_STUB_RESPONSES:?}/agent_get.${3:-}.json" ]; then
  cat "${HERDR_STUB_RESPONSES:?}/agent_get.${3:-}.json"; exit 0
fi
f="${HERDR_STUB_RESPONSES:?}/${key}.json"
if [ -f "$f" ]; then cat "$f"; else echo "{\"id\":\"cli:$cmd:$sub\",\"result\":{}}"; fi
