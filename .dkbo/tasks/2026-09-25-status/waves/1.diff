+#!/usr/bin/env bash
+# dk-status --json [<任務>] — 把 tasks/ 的任務記憶轉成 JSON 給 dashboard 讀。schema 見 .dkbo/status-schema.md。
+# 只讀：零 token、不寫／建／刪任何檔，不叫 herdr、不看 session 綁定，所以在 herdr 外也跑得動。
+# JSON 一律由 jq 產生：每個任務一支 awk 把它的檔串成一條流（每檔前一行檔頭標記）、一次 jq 讀完，
+# 所以任務數翻倍，jq 呼叫只多固定次數，跟 process.md 有幾行無關。
+set -euo pipefail
+. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
+. "$DK_ROOT/lib/frontmatter.sh"
+. "$DK_ROOT/lib/brief.sh"
+. "$DK_ROOT/lib/kinds.sh"
+. "$DK_ROOT/lib/repos.sh"
+
+usage() { echo "dk-status: 目前只支援 --json（用法：dk-status --json [<任務>]）" >&2; exit 2; }
+[ "${1:-}" = --json ] && [ $# -le 2 ] || usage
+case "${2:-}" in -*) usage;; esac
+
+TASKS="$DK_ROOT/tasks"
+DK_TASK_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}-[^/]+$'   # _chores、BACKLOG.md、.、.. 都不是任務
+is_task() { [[ "$1" =~ $DK_TASK_RE ]] && [ -d "$TASKS/$1" ]; }
+task_names() { local p; for p in "$TASKS"/*/; do p="${p%/}"; p="${p##*/}"; if is_task "$p"; then echo "$p"; fi; done; }
+resolve() { # 資料夾名或短名 → 資料夾名。短名取日期最晚的那個（同 dk-timeline），但比對是逐字的，不當 glob
+  local x="$1" t hit=""
+  if is_task "$x"; then echo "$x"; return 0; fi
+  while IFS= read -r t; do if [ -n "$t" ] && [ "${t:11}" = "$x" ]; then hit="$t"; fi; done <<< "$(task_names)"
+  [ -n "$hit" ] || dk_die "no task '$x'"
+  echo "$hit"
+}
+
+# 一個任務 → 一行 JSON（mode=list 只給摘要，detail 再加詳情欄位）。行格式的解析全在 jq 裡：
+# 原文經 -R 讀進來就是 JSON 字串，引號、反斜線、tab、$(...) 都不會經過 shell。
+# brief 的表格例外：切欄走 lib/brief.sh（跳脫的 \| 由它保留），jq 只做同一套跳脫感知的切法。
+# shellcheck disable=SC2016  # jq 程式，$x 是 jq 變數
+JQ_TASK='
+def nl: if . == "" then [] else split("\n") end;
+def trim: sub("^[ \t]+"; "") | sub("[ \t]+$"; "");
+def fields: [splits("[ \t]+")] | map(select(. != ""));
+def nonempty: if . == null or . == "" then null else . end;
+def int_or_null: if type == "string" and test("^[0-9]+$") then tonumber else null end;
+def cells: split("\\|") | join("\u0001") | split("|") | map(split("\u0001") | join("|"));
+def globs: split(",") | map(trim) | map(select(. != "" and . != "—"));
+def tsline: test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}([ \t]|$)");
+
+# 檔頭行是 \u001edk-status:<路徑>（見 task_json 的 awk）。不直接把多個檔交給 jq -R 再看 input_filename：
+# 前一個檔沒有結尾換行時，jq 會把它的最後一行跟下一個檔的第一行黏成一行。
+(reduce inputs as $l ({f: "", m: {}};
+   if ($l | startswith("\u001edk-status:")) then .f = ($l | .[11:]) else .m[.f] += [$l] end) | .m) as $F
+| def lines($f): if $f == "" then [] else ($F[$f] // []) end;
+
+# .task.env：KEY="VALUE"（dk_env_set 不准值裡有 " \ $ `，所以去掉外層引號就是原值）
+(reduce (lines($taskenv)[] | capture("^(?<k>[A-Za-z_][A-Za-z0-9_]*)=(?<v>.*)$")) as $e ({};
+   .[$e.k] = ($e.v | if test("^\".*\"$") then .[1:-1] else . end))) as $E
+| def env($k): $E[$k] | nonempty;
+
+# process.md：第 1 欄不是時間戳的行略過（計數）；f 是 awk 式的欄位切法，給 dk_ts_pick 同款比對用
+lines($process) as $PL
+| [ $PL[] | select(tsline) | {ts: .[0:16], rest: (.[16:] | sub("^[ \t]+"; ""))} | .f = (.rest | fields) ] as $P
+| def pick($a; $b; $c): [ $P[] | select((.f[0] // "") == $a and ($b == "" or .f[1] == $b) and ($c == "" or .f[2] == $c)) | .ts ] | last;
+def closeline($n): [ $P[] | select(.rest | test("^wave-close[ \t]+" + $n + "[ \t]+tests[ \t]+.*[ \t]+[0-9]+[ \t]+agents closed$")) ] | last;
+
+# messages.log：<ts> <from> -> <to> [TYPE] 內文，或 <ts> <who> [ACK]；解析不出的行略過（計數）
+lines($messages) as $ML
+| [ $ML[] | select(tsline) | .[0:16] as $ts | (.[16:] | sub("^[ \t]+"; "")) as $r
+    | ( ($r | capture("^(?<from>[^ \t]+) \\[ACK\\][ \t]*$") | {ts: $ts, from: .from, to: null, type: "ACK", text: ""}),
+        ($r | capture("^(?<from>[^ \t]+) -> (?<to>[^ \t]+) \\[(?<type>[A-Z][A-Z_]*)\\]( (?<text>.*))?$")
+            | {ts: $ts, from: .from, to: .to, type: .type, text: (.text // "")}) ) ] as $M
+
+| ($brief_owners | nl | map(cells | {member: .[0], writable: ((.[1] // "") | globs),
+    readonly: ((.[2] // "") | globs), exclusive: ((.[3] // "") | globs)})) as $owners
+| ($brief_waves | nl | map(cells | {wave: (.[0] | int_or_null), type: .[1], member: .[2], what: .[3],
+    tier: .[4], done: .[5], review: (.[6] | nonempty)})) as $bwaves
+| ($brief_acc | nl | map(capture("^- \\[(?<c>.)\\] (?<t>.*)$") | {text: .t, checked: (.c == "x" or .c == "X")})) as $acc
+| ($brief_goal | nl | map(trim) | map(select(. != "")) | if length == 0 then null else join("\n") end) as $goal
+
+| ($repos | nl | map(fields) | map(select(length > 0))
+    | map({name: .[0], path: (.[1] // null), worktree: (.[2] // null), base: (.[3] // null)})) as $R
+| (lines($panes) | map(select(test("[^ \t]")))) as $PN
+
+# INDEX：名稱欄等於 DK_DISPLAY 的那一列（| 存成 ／，同 dk_index_set），多列取最後一列
+| (env("DK_DISPLAY")) as $display
+| (if $display == null then null else ($display | split("|") | join("／")) as $n
+    | [ lines($index)[] | split("|") | select(length >= 6 and .[2] == " " + $n + " ") ] | last end) as $row
+| ($row | if . == null then "unknown" else (.[4] | trim) as $s
+    | if (["planning", "running", "done", "abandoned"] | map(. == $s) | any) then $s else "unknown" end end) as $status
+
+| ([ $P[] | select(.rest | test("^task-close (merged |in-tree |abandoned: )")) ] | last) as $close
+| ([ $P[] | select(.f[0] == "ruling:")
+     | {ts: .ts, text: (.rest | sub("^ruling:[ \t]*"; "")), autonomous: (.rest | sub("^ruling:[ \t]*"; "") | startswith("[自主]"))} ]) as $rulings
+| ([ $P[] | .rest | capture("^wave-close[ \t]+(?<n>[0-9]+)[ \t]+tests[ \t]+.*[ \t]+[0-9]+[ \t]+agents closed$") | .n ] | unique | length) as $closed
+
+| {
+    dir: $dir,
+    short: (env("DK_SHORT") // ($dir | .[11:])),
+    display: $display,
+    date: ($dir | .[0:10]),
+    status: $status,
+    index_note: ($row | if . == null then null else (.[5] | trim) end),
+    branch: env("DK_BRANCH"),
+    worktree: env("DK_WORKTREE"),
+    task_tab: env("DK_TASK_TAB"),
+    repo_names: ($R | map(.name)),
+    current_wave: ($E.DK_WAVE | int_or_null),
+    waves_planned: ([ $bwaves[].wave | select(. != null) ] | unique | length),
+    waves_closed: $closed,
+    created_at: ([ $P[] | select(.f[0] == "task-new") | .ts ] | first),
+    gate1_at: pick("gate1"; "approved"; ""),
+    closed_at: ($close | if . == null then null else .ts end),
+    close_result: ($close | if . == null then null else (.rest | sub("^task-close "; "")) end),
+    updated_at: ($P | last | if . == null then null else .ts end),
+    panes_open: ($PN | length),
+    counts: {
+      rulings: ($rulings | length),
+      autonomous_rulings: ($rulings | map(select(.autonomous)) | length),
+      minors: $minors,
+      undelivered: ($M | map(select(.type == "UNDELIVERED")) | length),
+      escalations: ($M | map(select(.type == "ESCALATE")) | length)
+    }
+  }
+| if $mode == "list" then . else . + {
+    repos: $R,
+    brief: {goal: $goal, acceptance: $acc, owners: $owners, waves: $bwaves},
+    waves: ( ([ $bwaves[].wave | select(. != null) ]
+              + [ $P[] | select(.f[0] == "wave-open" and ((.f[1] // "") | test("^[0-9]+$"))) | .f[1] | tonumber ]) | unique
+      | map(tostring as $n | closeline($n) as $cl
+        | ([ $P[] | select(.f[0] == "review" and .f[1] == $n and .f[2] == "verdict") ] | last) as $rv
+        | ([ $P[] | select(.f[0] == "review" and .f[1] == $n and .f[2] == "skipped:") ] | last) as $rs
+        | ($cl | if . == null then null else (.rest | capture("^wave-close[ \t]+[0-9]+[ \t]+tests[ \t]+(?<t>.*)[ \t]+[0-9]+[ \t]+agents closed$") | .t) end) as $tests
+        | {
+            wave: ($n | tonumber),
+            opened_at: pick("wave-open"; $n; ""),
+            dev_done_at: pick("dev-done"; "wave"; $n),
+            review_spawned_at: pick("review"; $n; "spawned"),
+            review_verdict_at: pick("review"; $n; "verdict"),
+            review_verdict: (if $rv != null then ($rv.rest | sub("^review[ \t]+[0-9]+[ \t]+verdict[ \t]*"; ""))
+                             elif $rs != null then ($rs.rest | sub("^review[ \t]+[0-9]+[ \t]+"; ""))
+                             else null end),
+            closed_at: ($cl | if . == null then null else .ts end),
+            tests: $tests,
+            tests_ok: ($tests | if . == null then null else (test("failed") | not) end),
+            commits: [ $P[] | .rest | capture("^commit (?<sha>[0-9a-f]+) wave " + $n + "( repo (?<repo>[^ \t]+))?[ \t]*$")
+                       | {repo: (.repo // null), sha: .sha} ]
+          })),
+    # 依檔名（含 .md）的碼點序：glob 的順序隨 locale 而變，去掉 .md 再排又會讓 qa-b.md（- < .）跑到 qa.md 後面
+    members: ( $states | nl | sort_by(sub("^.*/"; "")) | map(. as $path | ($path | sub("^.*/"; "") | sub("\\.md$"; "")) as $name
+      # state：key: value；touched／todo 收 "  - " 項；其他鍵的縮排續行接在該鍵最後一次出現之後
+      | (reduce lines($path)[] as $l ({cur: null, lst: null, kv: {}, lists: {}};
+          if ($l | test("^[A-Za-z_][A-Za-z0-9_]*:")) then
+            ($l | capture("^(?<k>[A-Za-z_][A-Za-z0-9_]*):(?<v>.*)$")) as $m | ($m.v | trim) as $v
+            | if $m.k == "touched" or $m.k == "todo" then
+                .cur = null | .lst = $m.k
+                | .lists[$m.k] = ((.lists[$m.k] // []) + (if $v == "" or $v == "[]" then [] else [$v] end))
+              else .lst = null | .cur = $m.k | .kv[$m.k] = ((.kv[$m.k] // []) + [[$v]]) end
+          elif .lst != null and ($l | startswith("  - ")) then .lists[.lst] += [$l | .[4:]]
+          elif .lst == null and .cur != null and ($l | test("^[ \t]+[^ \t]")) then
+            .cur as $c | .kv[$c] |= (.[:-1] + [.[-1] + [$l | trim]])
+          elif ($l | test("^[^ \t]")) then .cur = null | .lst = null
+          else . end)) as $s
+      | def one($k): ($s.kv[$k] // []) | if length == 0 then null else (.[0] | map(select(. != "")) | join("\n") | nonempty) end;
+        {
+          name: $name,
+          status: one("status"),
+          wave: (one("wave") | int_or_null),
+          current: one("current"),
+          touched: ($s.lists.touched // []),
+          todo: ($s.lists.todo // []),
+          blocked_by: one("blocked_by"),
+          notes: ($s.kv.notes // [] | map(.[]) | map(select(. != "")) | if length == 0 then null else join("\n") end),
+          has_report: ($reports | nl | map(. == $name) | any)
+        }) ),
+    panes: ($PN | map(fields | {agent: .[0], pane: (.[1] // null), since_epoch: (.[2] | int_or_null),
+             group: (.[3] // null), tab: (.[4] // null), slot: (.[5] // null)})),
+    rulings: $rulings,
+    events: [ $P[] | {ts: .ts, kind: ((.f[0] // "") | sub(":$"; "")), text: .rest} ],
+    messages: $M,
+    skipped_lines: {process: (($PL | length) - ($P | length)), messages: (($ML | length) - ($M | length))}
+  } end
+'
+
+task_json() { # 資料夾名 list|detail → 一行 JSON
+  local t="$1" d="$TASKS/$1" f n st="" rp="" owners="" waves="" acc="" goal="" repos=""
+  local -a files=()
+  for f in "$d/process.md" "$d/messages.log" "$d/.task.env" "$d/.panes" "$TASKS/INDEX.md"; do
+    if [ -f "$f" ] && [ -r "$f" ]; then files+=("$f"); fi
+  done
+  for f in "$d"/state/*.md; do
+    case "$f" in *.report.md) continue;; esac
+    [ -f "$f" ] && [ -r "$f" ] || continue
+    files+=("$f"); st="$st$f"$'\n'
+    n="${f##*/}"; n="${n%.md}"
+    if [ -f "$d/state/$n.report.md" ]; then rp="$rp$n"$'\n'; fi
+  done
+  if [ -f "$d/brief.md" ]; then
+    owners=$(dk_brief_owners "$d/brief.md" 2>/dev/null || true)
+    waves=$(dk_brief_waves "$d/brief.md" 2>/dev/null || true)
+    acc=$(dk_brief_acceptance "$d/brief.md" 2>/dev/null || true)
+    goal=$(dk_brief_section "$d/brief.md" "## 目標" 2>/dev/null || true)
+  fi
+  repos=$(dk_repos_rows "$d" 2>/dev/null || true)
+  ok() { [ -f "$1" ] && [ -r "$1" ] && echo "$1" || true; }
+  # awk 對每一行都補上換行，檔尾缺換行也不會黏行；沒有檔時讀 /dev/null，不會去等 stdin
+  awk 'FNR == 1 { printf "\036dk-status:%s\n", FILENAME } { print }' ${files[@]+"${files[@]}"} < /dev/null \
+  | jq -n -R -c --arg dir "$t" --arg mode "$2" \
+    --arg process "$(ok "$d/process.md")" --arg messages "$(ok "$d/messages.log")" \
+    --arg taskenv "$(ok "$d/.task.env")" --arg panes "$(ok "$d/.panes")" --arg index "$(ok "$TASKS/INDEX.md")" \
+    --arg states "${st%$'\n'}" --arg reports "${rp%$'\n'}" \
+    --arg brief_owners "$owners" --arg brief_waves "$waves" --arg brief_acc "$acc" --arg brief_goal "$goal" \
+    --arg repos "$repos" --argjson minors "$(dk_minor_count "$d/process.md")" \
+    "$JQ_TASK"
+}
+
+kinds_down_json() { # 未過期的 kinds-down 列 → JSON 陣列；本地時間在 shell 算（dk_epoch_to_local），逐列對齊傳進 jq
+  local rows e locals="" _k _r
+  rows=$(dk_kinds_down_rows | awk '$2 ~ /^[0-9]+$/')
+  while read -r _k e _r; do
+    [ -n "${e:-}" ] || continue
+    locals="$locals$(dk_epoch_to_local "$e")"$'\n'
+  done <<< "$rows"
+  printf '%s' "$rows" | jq -R -s -c --arg locals "$locals" '
+    def trim: sub("^[ \t]+"; "") | sub("[ \t]+$"; "");
+    ($locals | split("\n")) as $L
+    | [ split("\n") | map(select(. != "")) | to_entries[] | .key as $i | .value
+        | capture("^[ \t]*(?<kind>[^ \t]+)[ \t]+(?<e>[0-9]+)(?:[ \t]+(?<x>[^ \t]+))?(?:[ \t]+(?<rt>[^ \t]+))?(?:[ \t]+(?<tn>[^ \t]+))?(?:[ \t]+(?<ag>[^ \t]+))?(?:[ \t]+(?<rs>.*))?$")
+        | {kind: .kind, until: $L[$i], until_epoch: (.e | tonumber), exact: (.x == "exact"),
+           recorded_at: (.rt // ""), from_task: (.tn // ""), agent: (.ag // ""), reason: ((.rs // "") | trim)} ]
+    | sort_by(.kind)'
+}
+
+version=""; has_version=false
+if [ -f "$DK_ROOT/VERSION" ]; then version=$(tr -d '[:space:]' < "$DK_ROOT/VERSION"); has_version=true; fi
+kd=$(kinds_down_json)
+# shellcheck disable=SC2016  # jq 程式
+HEAD='{schema_version: 1, dkbo_version: (if $hv then $v else null end), generated_at: $g, kinds_down: $kd}'
+
+if [ $# -eq 2 ]; then
+  t=$(resolve "$2")
+  task_json "$t" detail | jq -c --arg v "$version" --argjson hv "$has_version" --arg g "$(dk_now)" --argjson kd "$kd" \
+    "$HEAD"' + {task: .}'
+else
+  task_names | while IFS= read -r t; do [ -z "$t" ] || task_json "$t" list; done \
+    | jq -s -c --arg v "$version" --argjson hv "$has_version" --arg g "$(dk_now)" --argjson kd "$kd" \
+      "$HEAD"' + {tasks: sort_by(.dir)}'
+fi
diff --git a/.dkbo/status-schema.md b/.dkbo/status-schema.md
new file mode 100644
index 0000000..b99f9d9
--- /dev/null
+++ b/.dkbo/status-schema.md
@@ -0,0 +1,236 @@
+# dk-status JSON schema（`schema_version` 1）
+
+`dk-status --json` 印 **list 文件**（所有任務的摘要），`dk-status --json <任務>` 印 **detail 文件**（一個任務的完整記憶）。`<任務>` 可以是資料夾名（`YYYY-MM-DD-<短名>`）或短名（同短名有多個時取日期最晚的那個）。stdout 只有一行 JSON；exit 0 成功、1 找不到任務（stderr `dk: no task '<x>'`）、2 用法錯。
+
+dk-status 只讀：不寫、不建、不刪任何檔，不呼叫 herdr，不需要在 herdr 裡跑。它讀的全是 `.dkbo/` 底下的檔：`VERSION`、`.sessions/kinds-down`、`tasks/INDEX.md`，以及每個任務資料夾的 `.task.env`、`brief.md`、`process.md`、`messages.log`、`state/*.md`、`.panes`、`.repos`。任一個檔不存在時對應欄位給 `null` 或 `[]`，不報錯。
+
+## 相容規則
+
+- **只加欄位不升 `schema_version`；改名、刪欄、改型別、改語意才升。**
+- 消費端遇到不認識的欄位要忽略，不要因此報錯 —— 新版 dkbo 加了欄位，舊 dashboard 照樣能讀。
+- 消費端應先看 `schema_version`：不認得的版本就別照舊解析。
+
+## 三件要知道的事
+
+1. **`kinds_down[].until` 是跑 dk-status 那台機器的本地時間**（`YYYY-MM-DDTHH:MM`，經 `dk_epoch_to_local` 換算，不帶時區）。dashboard 跑在別的時區、或要算倒數，請用 `until_epoch`（Unix 秒）。
+2. **messages 內文含換行時，續行沒有時間戳**：`messages.log` 一則一行，內文若夾了換行，第二行起第 1 欄不是時間戳，會被略過並計進 `skipped_lines.messages`（那則訊息的 `text` 只有第一行）。`process.md` 同理計進 `skipped_lines.process`。空行也算一行被略過。
+3. **閘門結果去 `events[]` 找**（對應 request 的「閘門狀態」）。`kind` 是 process 行第 2 欄去掉尾端冒號：
+   - `wave-close`：`dk-wave-close` 的結果。`wave-close N tests ok (…) K agents closed` 是測試閘過、波關閉；`wave-close N tests failed (…)`（沒有 `agents closed`）是測試閘擋下、波沒關；帶 `agents closed` 的 `failed` 行是 `--force` 強關。各波的整理結果在 detail 的 `waves[].closed_at`／`tests`／`tests_ok`。
+   - `violation`：所有權閘擋下的改動，`violation unowned: <路徑>` ＝ 這一波沒有任何成員可以改那個檔。
+   - `unreported`：`unreported <路徑> (owner <成員>)` ＝ 成員改了自己擁有的檔、但 state 的 `touched` 漏報（只警告，不擋）。
+   - `review`：審查閘。`review N spawned …`（派審）、`review N verdict …`（裁定，複看會有多則，取最後一則即 `waves[].review_verdict`）、`review N skipped: …`（本波不審）；`review task …` 是整枝評議。
+
+## 時間戳
+
+型別寫 `ts` 的欄位都是 `YYYY-MM-DDTHH:MM`（本地時間，同 `dk_now`），來源是 process.md／messages.log 行首。沒有來源就是 `null`，不是 0。
+
+## list 文件
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `schema_version` | int | 否 | — | 本文件的版本，目前 1 |
+| `dkbo_version` | str | 可 | `.dkbo/VERSION` | 內容去掉所有空白與換行；沒有檔就 `null` |
+| `generated_at` | ts | 否 | 系統時鐘 | 產生這份 JSON 的時間（`dk_now`） |
+| `kinds_down` | [kinds_down 項] | 否 | `.sessions/kinds-down` | 專案層熔斷中、恢復時間未到的 kind，依 `kind` 升冪；過期列不列 |
+| `tasks` | [任務摘要] | 否 | `tasks/` | 每個符合 `YYYY-MM-DD-<短名>` 的資料夾一筆，依資料夾名升冪；不含 `_chores`、`BACKLOG.md` |
+
+### kinds_down 項
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `kind` | str | 否 | kinds-down 第 1 欄 | 被熔斷的 kind（claude／codex／agy…） |
+| `until` | str | 否 | 第 2 欄經 `dk_epoch_to_local` | 恢復時間，**本地時間** `YYYY-MM-DDTHH:MM` |
+| `until_epoch` | int | 否 | 第 2 欄 | 恢復時間（Unix 秒），跨時區用這個 |
+| `exact` | bool | 否 | 第 3 欄 | `true`＝從畫面解析到確切恢復時間；`false`＝猜的（現在＋5 小時） |
+| `recorded_at` | str | 否 | 第 4 欄 | 記錄時間（`dk_now` 格式；欄缺則空字串） |
+| `from_task` | str | 否 | 第 5 欄 | 記錄它的任務資料夾名 |
+| `agent` | str | 否 | 第 6 欄 | 撞到額度的 agent 名 |
+| `reason` | str | 否 | 第 7 欄起 | 命中的畫面文字 |
+
+### 任務摘要
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `dir` | str | 否 | 資料夾名 | 任務資料夾名，也是 detail 模式可用的引數 |
+| `short` | str | 否 | `.task.env` `DK_SHORT` | 短名；沒有 `.task.env` 就取資料夾名日期之後那段 |
+| `display` | str | 可 | `.task.env` `DK_DISPLAY` | 顯示名稱 |
+| `date` | str | 否 | 資料夾名 | `YYYY-MM-DD` |
+| `status` | str | 否 | `tasks/INDEX.md` | `planning`／`running`／`done`／`abandoned`／`unknown`；取名稱欄等於 `display` 的那一列（`\|` 存成 `／`，同 `dk_index_set`），沒有那一列或狀態不在前四種就是 `unknown` |
+| `index_note` | str | 可 | `tasks/INDEX.md` | 那一列的「一句結論」原文（常見 `—`、`merged <sha>`）；沒有那一列就 `null` |
+| `branch` | str | 可 | `.task.env` `DK_BRANCH` | 任務分支 |
+| `worktree` | str | 可 | `.task.env` `DK_WORKTREE` | 主 repo 的 worktree 路徑（結案後已刪） |
+| `task_tab` | str | 可 | `.task.env` `DK_TASK_TAB` | 任務根 tab 的 herdr id，給 dashboard 對上即時狀態 |
+| `repo_names` | [str] | 否 | `.repos` 第 1 欄 | 本任務的 repo 名，主 repo 在第一個；單 repo 是 `["main"]` |
+| `current_wave` | int | 可 | `.task.env` `DK_WAVE` | 目前開著的波號；沒有開著的波就 `null` |
+| `waves_planned` | int | 否 | `brief.md` 波次表 | 波次表裡不同波號的個數 |
+| `waves_closed` | int | 否 | `process.md` | 有 `wave-close N tests … K agents closed` 行的不同波號個數 |
+| `created_at` | ts | 可 | `process.md` | 第一筆 `task-new` |
+| `gate1_at` | ts | 可 | `process.md` | 最後一筆 `gate1 approved`（關卡①放行） |
+| `closed_at` | ts | 可 | `process.md` | 最後一筆 `task-close merged …`／`task-close in-tree …`／`task-close abandoned: …`；`merge-failed`、`local-changes:` 不算結案 |
+| `close_result` | str | 可 | `process.md` | 同一行 `task-close ` 之後的原文（如 `merged 82bd82b`、`abandoned: <原因>`） |
+| `updated_at` | ts | 可 | `process.md` | 最後一行合法時間戳 |
+| `panes_open` | int | 否 | `.panes` | 列數（非空行）＝還開著的 pane 數 |
+| `counts` | object | 否 | 見下 | 各類計數 |
+
+`counts` 的鍵：
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `rulings` | int | 否 | `process.md` | 第 2 欄為 `ruling:` 的行數 |
+| `autonomous_rulings` | int | 否 | `process.md` | 其中本文以 `[自主]` 開頭的行數（領導自主裁定） |
+| `minors` | int | 否 | `process.md` | `minor: …`／`minor N: …` 行數（同 `dk_minor_count`） |
+| `undelivered` | int | 否 | `messages.log` | `type` 為 `UNDELIVERED` 的訊息數 |
+| `escalations` | int | 否 | `messages.log` | `type` 為 `ESCALATE` 的訊息數 |
+
+## detail 文件
+
+頂層鍵：`schema_version`、`dkbo_version`、`generated_at`、`kinds_down`（同 list）與 `task`。`task` 是任務摘要的所有欄位，再加下列九個：
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `task` | object | 否 | — | 任務摘要＋下列欄位 |
+| `repos` | [object] | 否 | `.repos` | 每列一個 repo |
+| `brief` | object | 否 | `brief.md` | 計畫內容；沒有 brief 時四個欄位是 `null`／`[]` |
+| `waves` | [object] | 否 | `process.md`＋`brief.md` | 每一波的時間線；波號取 brief 波次表與 process `wave-open N` 的聯集，升冪 |
+| `members` | [object] | 否 | `state/*.md` | 每個 state 檔一位（不含 `*.report.md`），依檔名升冪 |
+| `panes` | [object] | 否 | `.panes` | 還開著的 pane |
+| `rulings` | [object] | 否 | `process.md` | 裁定 |
+| `events` | [object] | 否 | `process.md` | process 的每一個合法行 |
+| `messages` | [object] | 否 | `messages.log` | 每一則解析得出的訊息 |
+| `skipped_lines` | object | 否 | `process.md`＋`messages.log` | 被略過的行數 |
+
+### `repos[]`
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `name` | str | 否 | `.repos` 第 1 欄 | repo 名（單 repo 是 `main`） |
+| `path` | str | 可 | 第 2 欄 | repo 根的絕對路徑 |
+| `worktree` | str | 可 | 第 3 欄 | 這個 repo 的任務 worktree |
+| `base` | str | 可 | 第 4 欄 | 實體化當下的 base sha |
+
+### `brief`
+
+| 鍵 | 型別 | 可否 null | 來源 | 說明 |
+|---|---|---|---|---|
+| `goal` | str | 可 | `## 目標` 段 | 非空行去頭尾空白、以 `\n` 串接 |
+| `acceptance` | [object] | 否 | `## 驗收標準` 段 | 每條 `- [ ] …`／`- [x] …` 一項 |
+| `owners` | [object] | 否 | `## 檔案所有權` 表 | 每位成員一項（範例列不算） |
+| `waves` | [object] | 否 | `## 波次表` | 每列一項（範例列不算） |
+
+表格切欄經 `lib/brief.sh`，欄內跳脫的 `\|` 還原成字面管線 `|`。
+
+`brief.acceptance[]`：
+
