+    [ "$(jq -r '.opened_at // ""' <<< "$w")" = "$(dk_ts_pick "$p" wave-open "$n")" ]
+    [ "$(jq -r '.dev_done_at // ""' <<< "$w")" = "$(dk_ts_pick "$p" dev-done wave "$n")" ]
+    [ "$(jq -r '.review_spawned_at // ""' <<< "$w")" = "$(dk_ts_pick "$p" review "$n" spawned)" ]
+    [ "$(jq -r '.review_verdict_at // ""' <<< "$w")" = "$(dk_ts_pick "$p" review "$n" verdict)" ]
