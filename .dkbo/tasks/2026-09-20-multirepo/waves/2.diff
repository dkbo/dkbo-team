+  [ -n "$m" ]; [ -n "$mg" ]
+  git -C "$PROJECT" merge-base --is-ancestor "$m" "$mg"   # 記憶那一筆在合併那一筆之前
+  git -C "$PROJECT" show --stat "$m" | grep -q report.md
