+# 三個 repo 的分支上各改一次 f.txt（內容＝repo 名），讓每個 repo 都真的有東西要合。
+seed_branch_commits() {
+  local n wt
+  for n in main api shared; do
+    wt="$PROJECT/.worktrees/login/$n"
+    echo "${1:-$n}" > "$wt/f.txt"; git -C "$wt" add f.txt
+    git -C "$wt" -c user.name=t -c user.email=t@t commit -q -m wave1
+  done
