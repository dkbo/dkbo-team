 #!/usr/bin/env bash
 # dk-resume [<task-folder|short>] — print a ≤150-line recovery pack for the leader.
 set -euo pipefail
-. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
+. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"; . "$DK_ROOT/lib/repos.sh"
 if [ -n "${1:-}" ]; then
   t="$1"; [ -d "$DK_ROOT/tasks/$t" ] || t=$(compgen -G "$DK_ROOT/tasks/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$1" | tail -1 || true); t="${t##*/}"
   [ -n "$t" ] && [ -d "$DK_ROOT/tasks/$t" ] || dk_die "no task '$1'"
   mkdir -p "$DK_ROOT/.sessions"; echo "$t" > "$DK_ROOT/.sessions/${HERDR_PANE_ID:?}"
 fi
 dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env; dk_settings
 # once, before render: render may run up to four times to fit the 150-line budget
 watch=$("$DK_ROOT/bin/dk-watch" --ensure 2>/dev/null || echo "watch: unknown")
 # 時間也只算一次：render 重跑四次的話，每次重算會讓同一份輸出裡的兩段數字對不起來。
 now_min=$(dk_ts_minutes "$(dk_now)"); now_s=$(date +%s); task_min=""; wave_min=""
 ts=$(awk '$2=="task-new"{print $1; exit}' "$dir/process.md")
 if [ -n "$ts" ]; then task_min=$(dk_ts_minutes "$ts" || true); fi
 if [ -n "${DK_WAVE:-}" ]; then
   ts=$(dk_ts_pick "$dir/process.md" wave-open "$DK_WAVE")
   if [ -n "$ts" ]; then wave_min=$(dk_ts_minutes "$ts" || true); fi
 fi
 render() { # $1=process lines $2=state lines $3=ruling lines (0 = all)
   echo "## 你是 $(dk_leader_name)（任務 $(basename "$dir")）"
   echo "本任務的執行規範是 .dkbo/skills/run/SKILL.md（Claude Code：/dkbo-run）。若你要接手推進，先讀它與 .dkbo/LEADER.md。任務目錄 $dir"
   echo "## brief"; cat "$dir/brief.md"
+  # .repos 在不在就是「實體化了沒」。領導接手的第一件事是知道自己有幾個 worktree 可以
+  # 派人進去；還沒交棒的話，這一段就是那句「先去 --run」。單 repo 模式不印名字欄
+  # （面向人的輸出在單 repo 模式一律不帶 repo 前綴）。
+  echo "## 倉庫"
+  if [ -f "$dir/.repos" ]; then
+    if dk_repos_multi; then dk_repos_rows "$dir" | awk '{printf "%s → %s\n", $1, $3}'
+    else dk_repos_rows "$dir" | awk 'NR==1{print $3}'; fi
+  else
+    echo "尚未交棒（/dkbo-run 會跑 dk-leader $DK_SHORT --run：切 worktree、開 workspace、把領導搬進去）"
+  fi
   echo "## 本波"
   if [ -n "$task_min" ]; then e=$((now_min - task_min)); echo "任務已進行 $((e/60))h $((e%60))m（自 task-new）"; fi
   if [ -n "$wave_min" ]; then echo "本波已進行 $((now_min - wave_min))m（自 wave-open）"; fi
   if [ -n "${DK_WAVE:-}" ]; then
     echo "wave: $DK_WAVE  base: $(dk_wave_base "$dir" "$DK_WAVE")  kinds down: ${DK_KIND_DOWN:-無}"
     awk -v t="$DK_REVIEW_TIMEOUT_MIN" -v now="$(date +%s)" -v pfx="$DK_SHORT-" -v dir="$dir" '
       NF>=6 && $4=="review" && (index($1, "-reviewer-") || $1 ~ /-reviewer$/) {
         sf=dir "/state/" substr($1, length(pfx)+1) ".md"; st="no-state"
         while ((getline l < sf) > 0) if (l ~ /^status: /) st=substr(l, 9); close(sf)
         printf "%s %s %d min%s\n", $1, st, (now-$3)/60, ((now-$3) > t*60 && st!="done") ? " TIMEOUT?" : "" }' "$dir/.panes"
