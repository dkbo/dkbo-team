+    dk_changed_files "${DK_WORKTREE:-}" "$(dk_wave_base "$d" "$n")"
+    return $?
+  fi
+  main=$(dk_repos_names "$d" | head -1)
+  while read -r name _root wt base; do
+    [ -n "$name" ] && [ -d "$wt" ] || continue
+    b=$(dk_wave_base "$d" "$n" "$name")
