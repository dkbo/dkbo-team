-.dkbo/bin/dk-version           # dkbo 0.9.2
+.dkbo/bin/dk-version           # dkbo 0.10.0
 ls -l .claude/skills .agents/skills | grep dkbo   # 十個 symlink
 tail -1 AGENTS.md CLAUDE.md     # 分別是入口行與 @AGENTS.md
