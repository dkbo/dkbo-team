+# --- dk-watch 整合：AC1 + AC5 --------------------------------------------------
+
+fixture_login() { d=$(fixture_task login 使用者登入); export DK_TASK_DIR="$d"; }
+screen() { printf '{"id":"cli:agent:read","result":{"read":{"text":"%s"}}}\n' "$1" > "$HERDR_STUB_RESPONSES/agent_read.json"; }
+
+@test "dk-watch 撞額度時寫入專案層 kinds-down，形狀符合共用契約" {
+  fixture_login
