+# AC18：真 herdr 拒收非 UTF-8 參數（rc=2）——`agent prompt` 的內文若切出半個字元就送不到，
+# stub 比照這個行為，測試才抓得到 dk-watch 的截斷是不是按位元組切的。
+dk_stub_utf8_valid() {
+  # 用 od 逐位元組讀（純數字，不靠 grep/read 對文字的 locale 假設——那條路子在某些
+  # locale 下會把整行吞掉或把多位元組字元黏成一個 token，比要驗的問題更難察覺）。
+  local s="$1" byte need=0
+  while read -r byte; do
+    [ -n "$byte" ] || continue
+    if [ "$need" -gt 0 ]; then
+      [ $((byte & 0xC0)) -eq 128 ] || return 1
+      need=$((need - 1)); continue
+    fi
+    if [ $((byte & 0x80)) -eq 0 ]; then continue
+    elif [ $((byte & 0xE0)) -eq 192 ]; then need=1
+    elif [ $((byte & 0xF0)) -eq 224 ]; then need=2
+    elif [ $((byte & 0xF8)) -eq 240 ]; then need=3
+    else return 1
+    fi
+  done < <(printf '%s' "$s" | od -An -v -tu1 | tr -s ' ' '\n' | sed '/^$/d')
+  [ "$need" -eq 0 ]
+}
