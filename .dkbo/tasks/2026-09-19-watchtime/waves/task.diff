+dk_span() { # START_TS END_TS → "Nm"；任一端缺或壞掉就 "—"
+  # 缺來源印「—」而不是 0：沒量到和量到零是兩件事，印 0 會讓時間表憑空多出一段假的即時完成。
+  local a b
+  [ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo "—"; return 0; }
+  a=$(dk_ts_minutes "$1") || { echo "—"; return 0; }
+  b=$(dk_ts_minutes "$2") || { echo "—"; return 0; }
