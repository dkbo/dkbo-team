@@ -54,21 +54,21 @@ if [ "$chore" = 0 ]; then
     [ -f "$panes" ] && fallback=$(awk -v n="$target" '$1==n{print $2; exit}' "$panes")
   fi
 fi
 [ "$fallback" = "$target" ] && fallback=""
 
 deliver() { # TARGET — 等它閒下來再送；兩步任一步失敗都算沒送到
   herdr agent wait "$1" --until idle --until "done" --timeout "${DK_MSG_WAIT_MS:-300000}" >/dev/null 2>&1 \
     && herdr agent prompt "$1" "$line" >/dev/null 2>&1
 }
 
-# [TASK] 開啟新的一輪。`.panes` 的 epoch 從此是「最後一次指派」而不是「spawn 以來」—— 不重設的話，
+# [TASK]／[BUG] 開啟新的一輪。`.panes` 的 epoch 從此是「最後一次指派」而不是「spawn 以來」—— 不重設的話，
 # 第二輪的 reviewer 一被派就已經超過 DK_REVIEW_TIMEOUT_MIN，逾時量的是錯的對象（BACKLOG 2026-09-14）。
 # 只在送達後重設：送不到的指派沒有開始任何一輪，先重設只會把卡住的人藏起來。
 # 同時存下 state 此刻的 cksum —— dk-watch 靠「內容有沒有變過」分辨這一輪交的 done 與上一輪留下的 done。
 # 用 cksum 不用 mtime：`date -r` 在 GNU 與 BSD 語義不同（同 dk-chore-tidy 的理由）。
 redispatch() { # AGENT — 只動 .panes 裡真的有的列；雜務與已收工的對象不憑空生列
   local a="$1" p sf
   p="$dir/.panes"; sf="$dir/state/${a#"$DK_SHORT"-}.md"
   [ -f "$p" ] || return 0
   awk -v n="$a" '$1==n{f=1} END{exit !f}' "$p" || return 0
   awk -v n="$a" -v t="$(date +%s)" 'NF>=3 && $1==n {$3=t} {print}' "$p" > "$p.tmp" && mv "$p.tmp" "$p"
@@ -76,19 +76,19 @@ redispatch() { # AGENT — 只動 .panes 裡真的有的列；雜務與已收工
   rm -f "$dir/.blocked/$a.timeout"   # 上一輪的逾時已結案；留著的 delivered 會讓這一輪永遠不再報
   if [ -f "$sf" ]; then cksum < "$sf"; else printf ''; fi > "$dir/.blocked/$a.redispatch"
 }
 
 # 重試而不是一次定生死：實跑中 reviewer 的 [DONE] 曾在一分鐘內就被判失敗、整筆遺失，
 # 而它的報告好端端躺在磁碟上 —— 領導從不知道它交過。
 tries="${DK_MSG_TRIES:-3}"; i=1
 while [ "$i" -le "$tries" ]; do
   # log 一律記解析後的名字，不記 pane id：那是人與 dk-wave-close 讀的那一欄。
   if deliver "$target" || { [ -n "$fallback" ] && deliver "$fallback"; }; then
-    if [ "$chore" = 0 ] && [ "$type" = TASK ]; then redispatch "$target"; fi
+    if [ "$chore" = 0 ] && { [ "$type" = TASK ] || [ "$type" = BUG ]; }; then redispatch "$target"; fi
     echo "$(dk_now) $sender -> $target [$type] $body" >> "$log"; exit 0
   fi
   [ "$i" -lt "$tries" ] && sleep "${DK_MSG_RETRY_SEC:-5}"
   i=$((i+1))
 done
 echo "$(dk_now) $sender -> $target [UNDELIVERED] [$type] $body" >> "$log"
 echo "dk-msg: undelivered to $target (logged); note it in your state blocked_by and continue" >&2
 exit 1
diff --git a/.dkbo/bin/dk-watch b/.dkbo/bin/dk-watch
index f63fa63..6b118c1 100755
--- a/.dkbo/bin/dk-watch
+++ b/.dkbo/bin/dk-watch
@@ -121,26 +121,29 @@ handle_limit() { # agent — 撞額度。不必等 DK_REVIEW_TIMEOUT_MIN：那
   fi
   grep -q '^delivered$' "$m" && return 0
   if notify_leader "$(dk_leader_name)" "${DK_ROOT_PANE:-}" "[LIMIT] from dk-watch: $agent 撞額度"; then echo delivered >> "$m"; fi
 }
 
 # agent_status 前提（highfix BACKLOG）：正在工作時畫面上的字是它的工作內容，不是卡住的證據 ——
 # 自己編輯、cat 出來的內容含 usage limit／Requesting permission 之類字樣都會被誤判。working 就
 # 不看畫面；agent_status 拿不到（不在名單裡、herdr 失敗）時寧可誤報也不可漏掉真卡住，照舊判定。
 # state 已 status: done 的 agent 同理跳過：這一輪它已交差，畫面殘留的字樣不該再判它
 # （highfix 第二次誤判：reviewer 交報告後被自己引用的 usage limit 字樣熔斷）。
+# 但 done 認定跟逾時路徑（tick() 的 reviewer timeout 區塊）同一條：被 [TASK]／[BUG] 重新
+# 指派過（存在 .redispatch）而 state 內容跟指派當下一模一樣，代表它沒有交差，不能豁免（AC15）。
 skip_screen_check() { # agent [list]
-  local agent="$1" list="${2:-}" sname sf
+  local agent="$1" list="${2:-}" sname sf rd
   [ -n "$list" ] || list=$(dk_h_soft agent list 2>/dev/null) || list=""
   [ "$(agent_status "$agent" "$list")" = working ] && return 0
-  sname="${agent#"$DK_SHORT"-}"; sf="$dir/state/$sname.md"
-  [ -f "$sf" ] && grep -q '^status: done' "$sf" 2>/dev/null && return 0
+  sname="${agent#"$DK_SHORT"-}"; sf="$dir/state/$sname.md"; rd="$dir/.blocked/$agent.redispatch"
+  if [ -f "$sf" ] && grep -q '^status: done' "$sf" 2>/dev/null \
+     && { [ ! -f "$rd" ] || [ "$(cksum < "$sf")" != "$(cat "$rd")" ]; }; then return 0; fi
   return 1
 }
 
 assess() { # agent [list] — 讀一次畫面並處理。回 0 表示畫面說了話（卡審批或撞額度）
   local agent="$1" list="${2:-}" txt kind
   skip_screen_check "$agent" "$list" && return 1
   txt=$(pane_text "$agent"); [ -n "$txt" ] || return 1
   kind=$(agent_kind "$agent")
   # 額度優先於審批：兩種字樣同時在畫面上時，擋住去路的是額度
   if screen_hits "$txt" "$(dk_kind_re "$kind" quota)"; then handle_limit "$agent"; return 0; fi
