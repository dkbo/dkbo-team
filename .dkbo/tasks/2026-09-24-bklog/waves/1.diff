+  [ "$(printf '%s\n' "$output" | grep -c '^WARN 所有權:')" -eq 1 ]   # tests/auth.bats 有主（qa 的 tests/**）
+}
+@test "bklog AC8: 測試檔有人擁有就不 WARN" {
