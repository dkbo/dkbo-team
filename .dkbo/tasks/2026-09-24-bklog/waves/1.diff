+# --- 0.16.0 AC4（#26）：計畫審查補派 ------------------------------------------------
+@test "AC4: 補派計畫審查 → 別名 p2、spawned 行兩位都在、p1 的 pane 不被關" {
+  have_request
+  run dk-brief-review --kinds claude; [ "$status" -eq 0 ]; [ "$output" = "brief-review: login-reviewer-p1(claude)" ]
