+  grep -q '^login-backend ' "$d/.panes"; [ ! -e "$d/.panes.lock" ]
+  rm "$d/.blocked/held"; hold_panes_lock "$d"
+  t0=$(date +%s); run dk-spawn backend --resume; t1=$(date +%s)
