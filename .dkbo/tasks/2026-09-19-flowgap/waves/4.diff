+  grep -v '^（' "$dir/report.md" 2>/dev/null | grep -qi 'minor' \
     || echo "dk-task-close: process.md 有 $mn 條 minor，但 report.md 沒提到 —— 整枝評議 triage 過的話，把沒修的寫進「未完成 / 遺留」段" >&2
