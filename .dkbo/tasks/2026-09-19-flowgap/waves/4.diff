 dk_require_herdr
 dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env
 abandon=0; reason=""
 [ "${1:-}" = --abandon ] && { abandon=1; reason="${2:-（未填原因）}"; }
