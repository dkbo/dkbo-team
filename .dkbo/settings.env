# dkbo 設定。/dkbo-init 會改寫這裡的值；bash 可直接 source，所有值都要加引號。
DK_TEST_CMD="tests/run.sh"                  # dk-wave-close 在 worktree 執行的測試指令；空字串表示不跑
DK_REVIEW_KINDS="claude"        # 預設 reviewer kind，依偏好排序，1 至 3 個，空白分隔
DK_REVIEW_MIN="1"               # 至少幾位 reviewer 意見回來才算審查完成
DK_REVIEW_TIMEOUT_MIN="20"      # reviewer 逾時分鐘（dk-watch 用）
DK_TAB1_SLOTS="4"               # tab 1 右側可放的員工格數（4 = 2×2，6 = 3×2）
DK_LEADER_KIND="claude"         # 領導這一側的 AI CLI（claude / codex / agy）；dk-leader 用它的 L 檔
DK_WAVE_TIMEOUT_MIN="60"      # 整波逾時分鐘（dk-watch 用）；0 表示關閉
DK_REVIEW_TIER="M"              # reviewer 的檔位（M 或 L）。審查是全隊最吃推理的位置，而 reviewer 是
                                # --isolated 唯讀、只讀一個 diff pack、單輪，升到 L 的邊際成本遠低於
                                # 一個 dev pane。要加碼就改這裡，不要去動 roles/reviewer.md 的 tier 定義。
