#!/usr/bin/env bash
# dk-leader <short> "<display>" [--kind claude] [--model M] [--effort E]  — open a second leader pane.
# dk-leader <short> --run       [--kind claude] [--model M] [--effort E]  — 實體化任務（worktree＋herdr
#   workspace）並交棒給該 workspace 根 pane 的執行領導。/dkbo-run 的第 0 步；見 skills/run/SKILL.md。
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
. "$DK_ROOT/lib/kinds.sh"
dk_require_herdr
short="${1:-}"; shift || true
[[ "$short" =~ ^[a-z][a-z0-9-]{0,11}$ ]] || dk_die "short name must be ascii lowercase, ≤12 chars"
run=0; display=""
if [ "${1:-}" = --run ]; then run=1; shift
else
  display="${1:-}"; shift || true
  [ -n "$display" ] || dk_die "display name required"
  [[ "$display" != *[\"\$\`\\]* ]] || dk_die "display name must not contain \" \$ \` or backslash"
fi
dk_settings
kind="$DK_LEADER_KIND"; model=""; effort=""
while [ $# -gt 0 ]; do case "$1" in --kind) kind="$2";; --model) model="$2";; --effort) effort="$2";; *) dk_die "unknown flag $1";; esac; shift 2; done
dk_kind_load "$kind"
ltier=$(echo "$KIND_DEFAULT_TIERS" | tr ' ' '\n' | awk -F= '$1=="L"{print $2}')   # 領導用最高檔
[ -n "$model" ]  || model="${ltier%%/*}"
[ -n "$effort" ] || effort="${ltier##*/}"
args=$(dk_kind_args "$kind" "$model/$effort")
# CLI 那側的 session 顯示名＝workspace 名，人在 session picker 與終端標題上看到的就是 dk/<short>。
# claude 有 --name，codex 與 agy 沒有對應旗標，回空字串（契約：kinds/<kind>.sh 的 kind_session_args）。
sess=$(kind_session_args "dk/$short")

# --run 的 rollback 與它的狀態。定義在 if 外面：函式體在呼叫時才展開，而寫在 if 裡面
# 會被 shellcheck 判成 unreachable（SC2317 —— 它看不出它會被叫到）。
created_wt=0; new_ws=""; env_written=0; wt_path=""
old_ws=""; old_root=""; old_leader=""; old_wt=""; old_base=""
rollback() { # agent start 之前任一步失敗：只還原這一次真的動過的東西
  if [ "$created_wt" = 1 ]; then
    git -C "$DK_PROJECT_ROOT" worktree remove --force "$wt_path" >/dev/null 2>&1 || true
    git -C "$DK_PROJECT_ROOT" branch -D "dk/$short" >/dev/null 2>&1 || true
  fi
  [ -z "$new_ws" ] || herdr workspace close "$new_ws" >/dev/null 2>&1 || true
  if [ "$env_written" = 1 ]; then
    dk_env_set DK_WORKSPACE "$old_ws"; dk_env_set DK_ROOT_PANE "$old_root"; dk_env_set DK_LEADER_PANE "$old_leader"
    dk_env_set DK_WORKTREE "$old_wt"; dk_env_set DK_BASE "$old_base"
  fi
}
# 明確呼叫，不掛 trap EXIT。這一版原本是掛 trap 的，而 rollback 只做了一半 —— worktree 刪了、
# workspace 關了，.task.env 卻留著實體化後的值：dk_env_set 的第一行是 `d=$(dk_task_dir) || return 1`，
# 而 dk_task_dir 當時結尾是裸 return，bash 規定 trap handler 裡的裸 return 回的是「觸發 trap 的那個
# 狀態」（失敗路徑上就是 1）。common.sh 那一行已改成 return 0（回歸測試 01_common.bats），但這裡
# 維持明確呼叫：rollback 到底有沒有跑完，不該吊在另一支 lib 的一行上，而它失效時是完全無聲的。
rb_die() { rollback; dk_die "$@"; }

if [ "$run" = 1 ]; then
  dir=$(compgen -G "$DK_ROOT/tasks/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$short" | tail -1 || true)
  [ -n "$dir" ] || dk_die "no task $short"
  DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env
  grep -Eq '^[^ ]+ gate1 approved$' "$dir/process.md" \
    || dk_die "任務 $short 還沒過關卡①（process.md 沒有 gate1 approved）：先給人確認再 dk-task-new $short --gate1"
  [ -z "${DK_WAVE:-}" ] || dk_die "任務 $short 還有開著的波（wave $DK_WAVE）：先 dk-wave-close 收完這一波再交棒"

  pane_agent_name() { herdr agent get "$1" 2>/dev/null | dk_json '.result.agent.name // empty' || true; }

  # 「實體化了沒」＝ .task.env 的 DK_WORKTREE 有沒有值（計畫階段是空字串，dk_legacy_task 只看
  # DK_BASE= 這一行在不在，空值不是 legacy）。多 repo 的 .repos 在波 2 一起進來。
  materialized=0
  if [ -n "${DK_WORKTREE:-}" ]; then
    if [ -n "${DK_WORKSPACE:-}" ] && ! herdr workspace get "$DK_WORKSPACE" >/dev/null 2>&1; then
      dk_die "任務 $short 已實體化（DK_WORKTREE=$DK_WORKTREE）但 workspace $DK_WORKSPACE 已不在；先人工收拾再跑"
    fi
    materialized=1
    if [ "$(pane_agent_name "${DK_ROOT_PANE:-}")" = "leader-$short" ]; then
      echo "dk-leader: 任務 $short 已交棒（workspace $DK_WORKSPACE 根 pane $DK_ROOT_PANE 上的 leader-$short）"
      exit 0
    fi
  fi

  old_ws="${DK_WORKSPACE:-}"; old_root="${DK_ROOT_PANE:-}"; old_leader="${DK_LEADER_PANE:-}"
  old_wt="${DK_WORKTREE:-}"; old_base="${DK_BASE:-}"; wt_path="$old_wt"

  if [ "$materialized" = 0 ]; then
    base_sha=$(git -C "$DK_PROJECT_ROOT" rev-parse HEAD)   # 交棒當下的 HEAD 才是對的起點（計畫可能拖幾天）
    if [ "${DK_NO_WORKTREE:-}" = 1 ]; then
      wt_path="$DK_PROJECT_ROOT"
    else
      wt_path="${DK_WORKTREE_DIR:-$DK_PROJECT_ROOT/.worktrees}/$short"
      [ ! -e "$wt_path" ] || dk_die "worktree path exists: $wt_path"
      mkdir -p "$(dirname "$wt_path")"
      git -C "$DK_PROJECT_ROOT" worktree add -q -b "dk/$short" "$wt_path" "$base_sha" >/dev/null 2>&1 \
        || dk_die "git worktree add failed (branch dk/$short exists? run: git branch -D dk/$short)"
      created_wt=1
    fi
    # workspace 只是一個「cwd 指向主樹、label 是分支名」的容器：領導必須站在主樹（.dkbo/ 在主樹，
    # 跑的也是主樹的腳本），員工 pane 照舊各自 --cwd。所以不用 herdr worktree create（plan.md 決策①）。
    out=$(herdr workspace create --cwd "$DK_PROJECT_ROOT" --label "dk/$short" --no-focus \
            --env "DK_ROOT=$DK_ROOT" --env "HERDR_ENV=1" 2>/dev/null || true)
    new_ws=$(printf '%s' "$out" | dk_json '.result.workspace.workspace_id // empty' 2>/dev/null || true)
    root_pane=$(printf '%s' "$out" | dk_json '.result.root_pane.pane_id // empty' 2>/dev/null || true)
    [ -n "$new_ws" ] && [ -n "$root_pane" ] \
      || rb_die "herdr workspace create 沒有回 workspace_id／root_pane（herdr 版本不符？）：$out"
    tab=$(herdr workspace get "$new_ws" 2>/dev/null | dk_json '.result.workspace.active_tab_id // empty' 2>/dev/null || true)
    if [ -z "$tab" ]; then dk_process "herdr-degraded: workspace get $new_ws（沒有 active_tab_id，tab 名字沒改）"
    elif ! herdr tab rename "$tab" "dk/$short" >/dev/null 2>&1; then dk_process "herdr-degraded: tab rename $tab"; fi

    env_written=1
    dk_env_set DK_WORKSPACE "$new_ws"; dk_env_set DK_ROOT_PANE "$root_pane"; dk_env_set DK_LEADER_PANE "$root_pane"
    dk_env_set DK_WORKTREE "$wt_path"; dk_env_set DK_BASE "$base_sha"
    DK_WORKSPACE="$new_ws"; DK_ROOT_PANE="$root_pane"; DK_LEADER_PANE="$root_pane"
    DK_WORKTREE="$wt_path"; DK_BASE="$base_sha"
    dk_process "materialize repos main workspace $new_ws"
  fi

  # 交棒。herdr 的註冊名唯一，所以先把呼叫者 pane 的 leader-<short> 清掉，執行領導才起得來。
  caller="${HERDR_PANE_ID:-}"
  if [ -n "$caller" ] && [ "$(pane_agent_name "$caller")" = "leader-$short" ]; then
    herdr agent rename "$caller" --clear >/dev/null \
      || rb_die "herdr agent rename $caller --clear 失敗：leader-$short 這個名字還被佔著，執行領導起不來"
  fi
  # agent start 之後不再 rollback：pane 留著、印診斷（同現行 dk-leader 的失敗路徑）
  # shellcheck disable=SC2086
  herdr agent start "leader-$short" --kind "$kind" --pane "$DK_ROOT_PANE" -- $args $sess >/dev/null \
    || dk_die "herdr agent start leader-$short 失敗（根 pane $DK_ROOT_PANE）"
  mkdir -p "$DK_ROOT/.sessions"; basename "$dir" > "$DK_ROOT/.sessions/$DK_ROOT_PANE"
  if [ -n "$caller" ] && [ "$caller" != "$DK_ROOT_PANE" ]; then rm -f "$DK_ROOT/.sessions/$caller"; fi
  dk_process "handoff run-leader pane $DK_ROOT_PANE"
  if ! herdr agent prompt "leader-$short" "讀 .dkbo/LEADER.md 與 .dkbo/skills/run/SKILL.md，然後執行 dk-resume $(basename "$dir") 並開始跑波。" --wait --until working --timeout 15000 >/dev/null; then
    echo "dk-leader: first prompt to leader-$short failed or timed out; pane $DK_ROOT_PANE 還活著 —— herdr agent read leader-$short 看它卡在哪，處理後再重送提示" >&2
    echo "leader-$short $DK_ROOT_PANE"; exit 1
  fi
  echo "leader-$short $DK_ROOT_PANE"; exit 0
fi

pane=$(herdr pane split --current --direction right --cwd "$DK_PROJECT_ROOT" --no-focus --env "DK_ROOT=$DK_ROOT" --env "HERDR_ENV=1" | dk_json '.result.pane.pane_id' || echo "")
[ -n "$pane" ] || dk_die "pane split returned no pane_id"
# shellcheck disable=SC2086
herdr agent start "leader-$short" --kind "$kind" --pane "$pane" -- $args $sess >/dev/null
# --until working：見 dk-spawn 的同一段註解。預設的 --wait 等的是「這一輪結束」，
# 而領導第一輪要讀 LEADER.md 與 plan 篇、跑 dk-task-new、開始寫 brief，一定超過任何合理逾時。
if ! herdr agent prompt "leader-$short" "讀 .dkbo/LEADER.md 與 .dkbo/skills/plan/SKILL.md，然後執行 .dkbo/bin/dk-task-new $short \"$display\" 並開始寫 brief。" --wait --until working --timeout 15000 >/dev/null; then
  echo "dk-leader: first prompt to leader-$short failed or timed out; pane $pane 還活著 —— herdr agent read leader-$short 看它卡在哪，處理後再重送提示" >&2
  echo "leader-$short $pane"; exit 1
fi
echo "leader-$short $pane"
