#!/usr/bin/env bash
# dk-chore <role> "<instruction>" [--kind K] [--tier S|M|L] [--code] [--cwd PATH]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
. "$DK_ROOT/lib/frontmatter.sh"; . "$DK_ROOT/lib/kinds.sh"
dk_require_herdr
role="${1:-}"; instr="${2:-}"; shift 2 || true
[ -n "$role" ] && [ -n "$instr" ] || dk_die "usage: dk-chore <role> \"<instruction>\" [--kind K] [--tier T] [--code] [--cwd PATH]"
kind=""; tier=M; code=0; cwd="$DK_PROJECT_ROOT"
while [ $# -gt 0 ]; do case "$1" in
  --kind) kind="$2"; shift 2;; --tier) tier="$2"; shift 2;; --code) code=1; shift;; --cwd) cwd="$2"; shift 2;;
  *) dk_die "unknown flag $1";; esac; done
rf="$DK_ROOT/roles/$role.md"; [ -f "$rf" ] || dk_die "no role file $rf (use add-role skill first)"
[ -n "$kind" ] || kind=$(dk_fm "$rf" kind)
spec=$(dk_fm_tier "$rf" "$tier"); [ -n "$spec" ] || dk_die "role $role has no tier $tier"
if [ "$kind" != "$(dk_fm "$rf" kind)" ]; then dk_kind_load "$kind"; spec=$(echo "$KIND_DEFAULT_TIERS" | tr ' ' '\n' | awk -F= -v t="$tier" '$1==t{print $2}'); fi
args=$(dk_kind_args "$kind" "$spec")
n=$(( $(compgen -G "$DK_ROOT/tasks/_chores/*.md" | wc -l || true) + 1 ))
agent="chore-$role-$n"; slug=$(dk_slug "${instr:0:24}"); slug="${slug:-chore$n}"
[[ "$agent" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || dk_die "agent name '$agent' must match [a-z][a-z0-9_-]{0,31} (shorten the role)"
cf="$DK_ROOT/tasks/_chores/$(dk_today)-$slug.md"; [ ! -e "$cf" ] || cf="${cf%.md}-$n.md"
branch="-"; ws="-"; split_from=(--current)   # ws stays "-": code chores use a plain git worktree, same as tasks (see dk-task-new)
if [ "$code" = 1 ]; then
  branch="chore/$slug"; cwd="${DK_WORKTREE_DIR:-$DK_PROJECT_ROOT/.worktrees}/chore-$slug"
  if [ -e "$cwd" ] || git -C "$DK_PROJECT_ROOT" rev-parse --verify -q "$branch" >/dev/null; then
    dk_die "chore branch $branch or worktree $cwd already exists (an unclosed chore? run dk-chore-close, or: git worktree remove $cwd; git branch -D $branch)"
  fi
  mkdir -p "$(dirname "$cwd")"
  git -C "$DK_PROJECT_ROOT" worktree add -q -b "$branch" "$cwd" HEAD >/dev/null 2>&1 || dk_die "git worktree add failed for $branch"
  rollback() { # any later step dying must not leave the worktree or branch behind
    git -C "$DK_PROJECT_ROOT" worktree remove --force "$cwd" >/dev/null 2>&1 || true
    git -C "$DK_PROJECT_ROOT" branch -D "$branch" >/dev/null 2>&1 || true
  }
  trap rollback EXIT
fi
direction=$(dk_fm "$rf" split); direction="${direction:-right}"
leader=$(herdr agent get "${HERDR_PANE_ID:?}" 2>/dev/null | dk_json '.result.agent.name // empty' || true); leader="${leader:-$HERDR_PANE_ID}"
pane=$(herdr pane split "${split_from[@]}" --direction "$direction" --cwd "$cwd" --no-focus \
  --env "DK_ROOT=$DK_ROOT" --env "DK_ROLE=$role" --env "DK_AGENT=$agent" --env "DK_CHORE_FILE=$cf" \
  --env "DK_LEADER=$leader" --env "DK_CHORE_CODE=$code" --env "HERDR_ENV=1" | dk_json '.result.pane.pane_id')
[ -n "$pane" ] || dk_die "pane split returned no pane_id"
dk_render "$DK_ROOT/templates/chore.md" "SOURCE=$instr" "AGENT=$agent" "KIND=$kind" "TIER=$tier" "BRANCH=$branch" "WORKSPACE=$ws" "PANE=$pane" > "$cf"
# shellcheck disable=SC2086
if ! herdr agent start "$agent" --kind "$kind" --pane "$pane" -- $args >/dev/null; then
  herdr pane close "$pane" >/dev/null 2>&1 </dev/null || true
  rm -f "$cf"
  dk_die "agent start failed for $agent (pane $pane closed)"
fi
prompt="你是 $agent，角色 $role，這是一件雜務。先讀 $DK_ROOT/roles/$role.md、$DK_ROOT/PROTOCOL.md、$DK_ROOT/PROJECT.md。交代：$instr。進度與結果寫在 $cf（status、touched、結果）。禁止使用 subagent。"
[ "$code" = 1 ] && prompt="$prompt 你在分支 $branch 的 worktree 中，完成後自己跑測試並 commit。範圍比想的大就停下回報。" || prompt="$prompt 不得修改程式碼。"
prompt="$prompt 完成後執行：$DK_ROOT/bin/dk-msg leader \"[DONE] <一句結果>\"（它會等領導閒置再送）。"
herdr agent prompt "$agent" "$prompt" --wait --timeout 60000 >/dev/null
dk_index_add "$(dk_today)" "${instr%%$'\n'*}" chore working "$cf"   # first line only; dk-chore-close matches the same
trap - EXIT   # chore fully started; keep the worktree
echo "$agent $pane $cf"
